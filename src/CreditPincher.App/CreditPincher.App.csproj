<?xml version="1.0" encoding="utf-8"?>
<!--
  A deliberately old-style project file.

  SDK-style projects (<Project Sdk="Microsoft.NET.Sdk">) need the .NET SDK installed.
  This one is built by the MSBuild 4.0 and C# compiler that ship inside every Windows
  install, under %WINDIR%\Microsoft.NET\Framework64\v4.0.30319 — so the app can be
  built on a bare machine with nothing added, including a locked-down LTSC image.

  CreditPincher.Core has no project file of its own any more: its sources are compiled
  straight into this assembly, so the build produces one self-contained
  CreditPincher.exe with no DLLs beside it.
-->
<Project ToolsVersion="4.0" DefaultTargets="Build"
         xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <OutputType>WinExe</OutputType>
    <RootNamespace>CreditPincher.App</RootNamespace>
    <AssemblyName>CreditPincher</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)\</IntermediateOutputPath>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <WarningLevel>4</WarningLevel>
    <!--
      Expect MSB3644 during the build: a bare Windows install has no targeting packs,
      so MSBuild resolves references from the GAC instead. That is what we want here,
      and MSBuild 4.0 has no way to silence it (NoWarn only reaches the C# compiler).
    -->
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <Optimize>false</Optimize>
    <DebugType>full</DebugType>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xaml" />
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <!-- WinForms is here only for the notification-area icon and its menu. -->
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Include="App.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </ApplicationDefinition>
    <Page Include="Views\DashboardWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Page Include="Views\QuickLogWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Page Include="Views\ConflictWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="App.xaml.cs">
      <DependentUpon>App.xaml</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
    <Compile Include="Views\DashboardWindow.xaml.cs">
      <DependentUpon>Views\DashboardWindow.xaml</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
    <Compile Include="Views\QuickLogWindow.xaml.cs">
      <DependentUpon>Views\QuickLogWindow.xaml</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
    <Compile Include="Views\ConflictWindow.xaml.cs">
      <DependentUpon>Views\ConflictWindow.xaml</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
    <Compile Include="AppServices.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Controls\UsageBarChart.cs" />
    <Compile Include="Platform\HotKeyManager.cs" />
    <Compile Include="Platform\SingleInstance.cs" />
    <Compile Include="Platform\StartupManager.cs" />
    <Compile Include="Services\WpfGitConflictResolver.cs" />
    <Compile Include="Theming\ThemeManager.cs" />
    <Compile Include="Theming\ThemePalette.cs" />
    <Compile Include="Theming\TitleBarTheme.cs" />
    <Compile Include="Tray\TrayController.cs" />
    <Compile Include="Tray\TrayIconRenderer.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Core is compiled in rather than referenced, so the output is a single file. -->
    <Compile Include="..\CreditPincher.Core\**\*.cs">
      <Link>Core\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
