<Window x:Class="CreditPincher.App.Views.ConflictWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Resolve backup conflicts"
        Height="460"
        Width="560"
        MinHeight="320"
        MinWidth="460"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="{StaticResource WindowBackgroundBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="0,0,0,12"
                   Text="Your usage log changed both here and on the remote. Choose how to resolve each file — merging keeps every entry from both machines." />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="FilesPanel" />
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Cancel backup"
                    MinWidth="120"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Click="OnCancelClick" />
            <Button x:Name="ResolveButton"
                    Style="{StaticResource AccentButton}"
                    Content="Resolve and continue"
                    MinWidth="160"
                    IsDefault="True"
                    Click="OnResolveClick" />
        </StackPanel>
    </Grid>
</Window>
